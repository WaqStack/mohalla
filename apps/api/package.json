{
  "name": "@mohalla/api",
  "version": "0.0.0",
  "private": true,
  "description": "Mohalla API - foundation only. Health endpoints and empty module shells.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mohalla/contracts": "*",
    "@mohalla/validation": "*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "helmet": "8.1.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
